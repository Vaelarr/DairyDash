{
  "name": "milkswift",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev.js",
    "dev": "node scripts/dev.js",
    "dev:web": "ng serve --host 0.0.0.0 --port 3000",
    "api": "node --env-file-if-exists=.env server/index.js",
    "api:dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test:api": "node --test server/tests/*.test.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-supabase.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-supabase.js",
    "build": "ng build",
    "mobile:sync": "node scripts/mobile.js sync",
    "mobile:build": "node scripts/mobile.js build",
    "mobile:run": "node scripts/mobile.js run",
    "mobile:open": "node scripts/mobile.js open",
    "watch": "ng build --watch --configuration development",
    "ionic:serve": "ionic serve",
    "ionic:build": "ionic build"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@ionic/angular": "^9.0.4",
    "@supabase/supabase-js": "^2.117.3",
    "express": "^5.2.1",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@capacitor/cli": "^8.5.3",
    "@electric-sql/pglite": "^0.5.8",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
