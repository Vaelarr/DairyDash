# Copy this file to .env. Fill in the server-only Supabase values after creating your project.
DATABASE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role keys are also supported through SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_STORAGE_BUCKET=dairydash-product-images

# Local Express API (Angular forwards /api here).
API_PORT=3001
# Browser development reaches the API through Angular's /api proxy.
API_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional offline development: explicitly set DATABASE_PROVIDER=sqlite.
DATABASE_PATH=server/data/dairydash.sqlite

# Checkout delivery fee in PHP (0 = free delivery).
CHECKOUT_DELIVERY_FEE=0
# Manual transfer methods are available only when merchant instructions are configured.
# Include the merchant name, destination account/number, and how to contact you about a receipt.
PAYMENT_GCASH_INSTRUCTIONS=
PAYMENT_MAYA_INSTRUCTIONS=
PAYMENT_BANK_TRANSFER_INSTRUCTIONS=
